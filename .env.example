# ---------------------------------------------------------------------------
# Kemet Foundation Inc — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/kemet_foundation?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used for SEO metadata, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="https://kemetfoundationinc.org"
NEXT_PUBLIC_ORG_EMAIL="info@kemetfoundationinc.org"

# Stripe (donations). Leave unset to keep the donation UI visible with
# checkout disabled until the organization provides real keys.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Transactional email (Resend). Leave unset to disable outgoing email;
# registration/event/donation flows still work, emails are logged only.
RESEND_API_KEY=""
EMAIL_FROM="Kemet Foundation Inc <no-reply@kemetfoundationinc.org>"

# Initial administrator account created by `npm run prisma:seed`.
# Change the password immediately after first login.
SEED_ADMIN_EMAIL="admin@kemetfoundationinc.org"
SEED_ADMIN_PASSWORD="ChangeMe123!"
