# ---------------------------------------------------------------------------
# Kemet Foundation Inc — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
#
# This site has no database — it's a static/server-rendered site with a
# contact form, membership interest form, newsletter signup, and donations,
# all delivered by email or handled directly by Square. Nothing here is
# required for the site to build and run; without it, forms show a clear
# "not yet configured" message instead of silently failing.
# ---------------------------------------------------------------------------

# Public site URL (used for SEO metadata, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="https://kemetfoundationinc.org"
NEXT_PUBLIC_ORG_EMAIL="info@kemetfoundationinc.org"

# Square (donations, including Cash App Pay). Leave unset to keep the
# donation UI visible with checkout disabled until the organization
# provides real credentials. Get these from the Square Developer
# Dashboard (https://developer.squareup.com/apps): the access token and
# location ID come from your application + location; the webhook
# signature key and notification URL come from the webhook subscription
# you create there pointing at <your-site>/api/donations/webhook.
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
# "sandbox" while testing, "production" once you have live credentials.
SQUARE_ENVIRONMENT="sandbox"
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_NOTIFICATION_URL="https://kemetfoundationinc.org/api/donations/webhook"

# Transactional email (Resend). Leave unset and the contact form,
# membership interest form, newsletter signup, and donation notifications
# will each return a clear "not yet configured" message instead of
# silently failing.
RESEND_API_KEY=""
EMAIL_FROM="Kemet Foundation Inc <no-reply@kemetfoundationinc.org>"

# Where contact form / membership interest / newsletter signup / donation
# notifications are delivered internally (comma-separated). Separate from
# NEXT_PUBLIC_ORG_EMAIL above, which is the address shown publicly on the
# site. Defaults to raphaell759@yahoo.com, greenwood100inc@gmail.com if unset.
ORG_NOTIFICATION_EMAILS="raphaell759@yahoo.com,greenwood100inc@gmail.com"
