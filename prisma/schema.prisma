generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
  SUPERADMIN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
  DECLINED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum ContactSubject {
  GENERAL
  MEMBERSHIP
  EVENTS
  DONATIONS
  VOLUNTEER
  PARTNERSHIP
  OTHER
}

enum ContactStatus {
  NEW
  READ
  RESOLVED
}

enum AnnouncementAudience {
  PUBLIC
  MEMBERS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile            MemberProfile?
  eventRegistrations EventRegistration[]
  donations          Donation[]
  createdEvents      Event[]             @relation("EventCreatedBy")

  @@index([role])
}

model MemberProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String
  city      String
  state     String
  zip       String

  businessOrg          String?
  occupation           String?
  skills               String?
  volunteerSkills      String?
  areasOfInterest      String?
  contributionInterest String?

  newsletterOptIn   Boolean  @default(false)
  termsAcceptedAt   DateTime
  privacyAcceptedAt DateTime

  membershipStatus    MembershipStatus @default(PENDING)
  appliedAt           DateTime         @default(now())
  reviewedAt          DateTime?
  reviewedByAdminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([membershipStatus])
}

model Event {
  id                   String      @id @default(cuid())
  title                String
  slug                 String      @unique
  description          String
  imageUrl             String?
  location             String
  startAt              DateTime
  endAt                DateTime
  registrationDeadline DateTime?
  capacity             Int?
  isFree               Boolean     @default(true)
  priceCents           Int?
  status               EventStatus @default(DRAFT)

  createdByUserId String?
  createdBy       User?   @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startAt])
}

model EventRegistration {
  id                      String             @id @default(cuid())
  eventId                 String
  event                   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                  RegistrationStatus @default(CONFIRMED)
  registeredAt            DateTime           @default(now())
  confirmationEmailSentAt DateTime?

  @@unique([eventId, userId])
  @@index([eventId])
}

model Donation {
  id                String            @id @default(cuid())
  donorName         String
  donorEmail        String
  amountCents       Int
  currency          String            @default("usd")
  frequency         DonationFrequency @default(ONE_TIME)
  dedicationMessage String?
  publicRecognition Boolean           @default(false)

  squarePaymentLinkId   String?        @unique
  squareOrderId         String?
  squarePaymentId       String?
  squareSubscriptionId  String?
  // Set only for MONTHLY donations: the dynamically-created Catalog
  // subscription plan variation priced for this exact donation amount.
  // Used to correlate the `subscription.created` webhook (which carries
  // no reference_id of its own) back to this row.
  squarePlanVariationId String?
  status                DonationStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  receiptEmailSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([donorEmail])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  title     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String         @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   ContactSubject @default(GENERAL)
  message   String
  status    ContactStatus  @default(NEW)
  ipAddress String?
  createdAt DateTime       @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  active         Boolean   @default(true)
  source         String?
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  audience    AnnouncementAudience @default(PUBLIC)
  isActive    Boolean              @default(true)
  publishedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
